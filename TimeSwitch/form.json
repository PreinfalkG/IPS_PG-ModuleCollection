{
    "elements": [
        {
            "type": "Label",
            "caption": "Jede Zeile verbindet eine selbst angelegte Integer-Variable 'Time Switch' (Sekunden) mit der Schaltvariable des Aktors. Die Aktion der Time-Switch-Variable wird automatisch auf diese Instanz gesetzt."
        },
        {
            "type": "NumberSpinner",
            "name": "PermanentValue",
            "caption": "Wert für Dauer-EIN (Sekunden, ohne Timer)",
            "minimum": 1
        },
        {
            "type": "List",
            "name": "Devices",
            "caption": "Zuordnung",
            "add": true,
            "delete": true,
            "rowCount": 12,
            "columns": [
                {
                    "caption": "Time Switch (Integer-Variable)",
                    "name": "TimeVar",
                    "width": "800px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Schaltvariable (STATE)",
                    "name": "SwitchVar",
                    "width": "800px",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "caption": "Treiber",
                    "name": "Driver",
                    "width": "340px",
                    "add": "generic",
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "HomeMatic / HmIP (natives ON_TIME)",
                                "value": "hm"
                            },
                            {
                                "caption": "Generisch (IP-Symcon schaltet aus)",
                                "value": "generic"
                            }
                        ]
                    }
                }
            ]
        }
    ],
 "actions": [
    {
      "type": "Label",
      "caption": "Export / Import der Zuordnung (JSON, Stand der zuletzt übernommenen Konfiguration)"
    },
    {
      "type": "ValidationTextBox",
      "name": "ExchangeText",
      "caption": "JSON",
      "multiline": true,
      "width": "80%",
      "value": ""
    },
    {
      "type": "CheckBox",
      "name": "ImportMerge",
      "caption": "Import mit vorhandenen Zeilen zusammenführen (sonst ersetzen)",
      "value": false
    },
    {
      "type": "RowLayout",
      "items": [
        {
          "type": "Button",
          "caption": "Export",
          "onClick": "TSCT_Export($id);"
        },
        {
            "type": "Button",
            "caption": "Export als Datei",
            "download": "TimeSwitch.json",
            "onClick": "echo 'data:application/json;base64,' . base64_encode(TSCT_Export($id));"
        },        
        {
          "type": "Button",
          "confirm": "Der JSON-Inhalt wird in die Tabelle geladen und ersetzt sie bzw. wird mit ihr zusammengeführt (je nach Checkbox). Fortfahren?",
          "caption": "Import",
          "onClick": "TSCT_Import($id, $ExchangeText, $ImportMerge);"
        }
      ]
    },
    {
      "type": "Label",
      "name": "ExchangeResult",
      "caption": ""
    }
  ],
  "status": []
}